# ========================================================
# NOTES MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port (default: 5000)
PORT=5000

# MongoDB Connection String:
# 1. For Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/notes_db
# MONGO_URI=mongodb://127.0.0.1:27017/notes_db

# 2. For MongoDB Atlas Cloud (Required for Vercel live deployment):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/notes_db?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=notes_app_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
